# ═══════════════════════════════════════════════════════════
# Vercel → Project Settings → Environment Variables
# Add these for Production (and Preview if you want).
# ONLY Vite-prefixed vars are safe in the browser build.
# ═══════════════════════════════════════════════════════════

# Your public Express API base URL (must end with /api)
# Example after you host the backend:
#   VITE_API_URL=https://api.your-domain.example/api
# Or a Railway/Render URL:
#   VITE_API_URL=https://icu-api.up.railway.app/api
VITE_API_URL=https://YOUR-BACKEND-HOST/api

# Do NOT put these on Vercel (frontend):
#   SUPABASE_SERVICE_ROLE_KEY
#   DATABASE_URL / DATABASE_DIRECT_URL
#   JWT_SECRET / JWT_REFRESH_SECRET
# Those belong only on the API host (see backend/.env.example).
