# ═══════════════════════════════════════════════════════════
# Vercel → Project Settings → Environment Variables
# ═══════════════════════════════════════════════════════════

# --- Frontend (build-time) ---
VITE_API_URL=/api

# --- Serverless API (runtime) — required for login ---
# Same values as backend/.env (Supabase + JWT)
DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_SSL=true
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=icu-uploads
JWT_SECRET=use-openssl-rand-hex-32-minimum-32-chars
JWT_REFRESH_SECRET=use-openssl-rand-hex-32-different
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Your Vercel site URL (CORS)
FRONTEND_URL=https://icu-blockchain-payment-system-bernards-projects-4bf0d9b6.vercel.app

NODE_ENV=production
BLOCKCHAIN_OPTIONAL=true
REDIS_ENABLED=false
TRUST_PROXY=true

# OCR will not run on Vercel (needs Python process). Leave unset or empty.
# PYTHON_SERVICE_URL=
