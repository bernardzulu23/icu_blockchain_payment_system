{
  "name": "icu-blockchain-payment-system",
  "version": "1.0.0",
  "description": "Blockchain-Based Automated Payment Reconciliation System for ICU Zambia",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm run dev:backend\" \"wait-on http://localhost:5000/health && npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:python": "cd backend/python-services && python api_server.py",
    "build": "cd frontend && npm run build",
    "db:migrate": "cd backend && npm run db:migrate",
    "start": "cd backend && npm start",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "dotenv": "^17.3.1",
    "serverless-http": "^3.2.0"
  }
}
