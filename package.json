{
  "name": "icu-blockchain-payment-system",
  "version": "1.0.0",
  "description": "Blockchain-Based Automated Payment Reconciliation System for ICU Zambia",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:python\" \"wait-on http://localhost:5000/health && npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:python": "node backend/python-services/start.js",
    "build": "cd frontend && npm run build",
    "db:migrate": "cd backend && npm run db:migrate",
    "start": "cd backend && npm start",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.9.6",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "bcrypt": "^5.1.1",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "serverless-http": "^3.2.0",
    "winston": "^3.19.0"
  }
}
