# Backend API — copy to backend/.env (VPS / Railway / local)
# Database: Neon (recommended) — use pooled URL at runtime, non-pooling for migrations

NODE_ENV=production
PORT=5000

# Vercel frontend origin(s) — required for CORS
FRONTEND_URL=https://your-app.vercel.app
# Optional: comma-separated preview URLs
# FRONTEND_URLS=https://your-app.vercel.app,https://your-app-git-main.vercel.app

# Neon PostgreSQL (from Vercel Neon integration or Neon console)
# Runtime: pooled connection
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Migrations: direct (non-pooling) — run npm run db:migrate with this set
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DB_SSL=true

JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
REFRESH_TOKEN_EXPIRES_IN=7d

REDIS_ENABLED=false

# File uploads — Vercel Blob when API stores files (same token as Vercel project)
BLOB_READ_WRITE_TOKEN=
UPLOAD_PATH=/tmp/uploads

# Python OCR service (same VPS or separate container)
PYTHON_SERVICE_URL=http://127.0.0.1:8000
OCR_CONFIDENCE_THRESHOLD=0.65

# Hyperledger Fabric (same VPS as peers — NOT on Vercel)
FABRIC_CONNECTION_PROFILE=./blockchain/network/connection-profile.json
FABRIC_WALLET_PATH=./blockchain/wallet
FABRIC_CHANNEL=icupaymentchannel
FABRIC_CHAINCODE=reconciliation-chaincode
FABRIC_IDENTITY=accountantAdmin
FABRIC_AS_LOCALHOST=true
BLOCKCHAIN_OPTIONAL=false

# Email (optional)
RESEND_API_KEY=
EMAIL_FROM=noreply@icu.edu.zm
