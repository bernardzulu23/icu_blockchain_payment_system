# Backend API — copy to backend/.env on the API host (VPS / Railway / Render).
# Database + file storage: Supabase.
# Do NOT paste this whole file into Vercel — Vercel hosts the React frontend only.

NODE_ENV=production
PORT=5000

# Frontend origin(s) for CORS — your Vercel site URL after deploy
# Example: https://icu-blockchain-payment-system.vercel.app
FRONTEND_URL=https://YOUR-APP.vercel.app
# Optional extra origins (comma-separated)
# FRONTEND_URLS=https://YOUR-APP.vercel.app,https://www.your-domain.example,http://localhost:5173


# ── Supabase Postgres ─────────────────────────
# Dashboard → Project Settings → Database → Connection string
# Use "Transaction" pooler for the app (port 6543) and "Session"/Direct for migrations (5432)
# Prefer a least-privilege role in production — see backend/scripts/create-app-db-role.sql
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SSL=true

# ── Supabase Storage (private bucket for slips/statements) ─
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=icu-uploads

JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-use-openssl-rand-hex-32-refresh
# Maps to JWT_ACCESS_SECRET in auth-hardening (same var names as above)
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
REFRESH_TOKEN_EXPIRES_IN=7d
TRUST_PROXY=true

# Run migrations after deploy: npm run db:migrate (adds lockout + token_version columns)

# Optional — signed cookies; generate with: openssl rand -hex 32
# COOKIE_SECRET=

# Extra CORS origins (comma-separated), merged with FRONTEND_URL
# ALLOWED_ORIGINS=https://www.your-domain.example

# JSON body size cap for API routes (uploads use multer separately)
# BODY_JSON_LIMIT=100kb

REDIS_ENABLED=false

UPLOAD_PATH=uploads

# Python OCR service (same VPS)
PYTHON_SERVICE_URL=http://127.0.0.1:8000
OCR_CONFIDENCE_THRESHOLD=0.65
API_PUBLIC_URL=https://api.your-domain.example

# Hyperledger Fabric (VPS with peers)
FABRIC_CONNECTION_PROFILE=./blockchain/network/connection-profile.json
FABRIC_WALLET_PATH=./blockchain/wallet
FABRIC_CHANNEL=icupaymentchannel
FABRIC_CHAINCODE=reconciliation-chaincode
FABRIC_IDENTITY=accountantAdmin
FABRIC_AS_LOCALHOST=true
BLOCKCHAIN_OPTIONAL=false

# Email (optional)
RESEND_API_KEY=
EMAIL_FROM=noreply@icu.edu.zm
