# ===========================================
# ICU Blockchain Payment System - Environment
# Copy to .env and fill in values
# NEVER commit .env to version control
# ===========================================

# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000/api

# Frontend
VITE_API_URL=http://localhost:5000/api

# PostgreSQL (use DATABASE_URL or individual vars)
DATABASE_URL=postgresql://icu_user:icu_password@localhost:5432/icu_payments
# Or:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=icu_payments
# DB_USER=icu_user
# DB_PASSWORD=icu_password
# DB_SSL=false

# Redis (use REDIS_URL or individual vars)
REDIS_URL=redis://localhost:6379
# Or:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Africa's Talking (SMS)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=ICU

# SendGrid (Email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@icu.edu.zm

# Python Batch Service
PYTHON_SERVICE_URL=http://localhost:8000

# Blockchain (Hyperledger Fabric)
FABRIC_CA_URL=https://localhost:7054
FABRIC_PEER_URL=grpc://localhost:7051
FABRIC_CHANNEL_NAME=icu-channel

# Docker Compose (for docker-compose up)
# DB_PASSWORD=postgres
# JWT_SECRET=your-super-secret-jwt-key-change-in-production
# FRONTEND_URL=http://localhost:3000
# VITE_API_URL=  (leave empty for relative /api when using nginx proxy)
