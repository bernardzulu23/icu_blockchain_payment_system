# ===========================================
# ICU Payment System — Environment template
# Copy sections to the right place (see docs/DEPLOYMENT.md)
# NEVER commit real secrets
# ===========================================

# ── Local development ────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Local Postgres (optional — or use Neon URLs below)
# DATABASE_URL=postgresql://icu_user:icu_password@localhost:5432/icu_payments

# ── Vercel (frontend only) ───────────────────
# Dashboard → Project → Settings → Environment Variables:
#   VITE_API_URL = https://YOUR-API-HOST/api
#
# Do NOT deploy the Express API to Vercel (Fabric gRPC + OCR need a long-lived host).
# vercel.json builds frontend/dist only.

# ── Neon PostgreSQL (via Vercel integration) ─
# 1. vercel link
# 2. vercel integration add neon
# 3. npm run env:pull          → creates .env.local with POSTGRES_* URLs
# 4. npm run db:migrate        → uses POSTGRES_URL_NON_POOLING when set
#
# Set on API host (VPS/Railway), not on Vercel frontend project:
#   DATABASE_URL              — pooled Neon URL (runtime queries)
#   POSTGRES_URL_NON_POOLING  — direct URL (migrations only)
#   DB_SSL=true

# ── API host (VPS / Railway) + Neon ─────────
# Copy backend/.env.example → backend/.env and fill:
#   FRONTEND_URL=https://your-app.vercel.app
#   DATABASE_URL=postgresql://...@...-pooler.neon.tech/...?sslmode=require
#   POSTGRES_URL_NON_POOLING=postgresql://...@....neon.tech/...?sslmode=require
#   BLOB_READ_WRITE_TOKEN=     (Vercel Blob — same project as frontend)
#   PYTHON_SERVICE_URL=        (OCR microservice on same VPS)
#   FABRIC_*                   (Fabric VPS only)

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
REDIS_ENABLED=false
BLOCKCHAIN_OPTIONAL=true

# Fabric (VPS API only — see backend/.env.example)
FABRIC_CHANNEL=icupaymentchannel
FABRIC_CHAINCODE=reconciliation-chaincode
FABRIC_IDENTITY=accountantAdmin

PYTHON_SERVICE_URL=http://localhost:8000
OCR_CONFIDENCE_THRESHOLD=0.65
BLOB_READ_WRITE_TOKEN=
UPLOAD_PATH=uploads
RUN_DB_MIGRATE=false
