# ===========================================
# ICU Payment System — Environment template
# Supabase Postgres + Storage | API on VPS
# NEVER commit real secrets
# ===========================================

# ── Local development ────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# ── Supabase (required for cloud) ────────────
# Project Settings → Database → URI
# DATABASE_URL=postgresql://postgres.xxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres
# DATABASE_DIRECT_URL=postgresql://postgres.xxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (Settings → API → service_role)
# SUPABASE_STORAGE_BUCKET=icu-uploads
# DB_SSL=true

# Local Postgres fallback (optional)
# DATABASE_URL=postgresql://icu_user:icu_password@localhost:5432/icu_payments

# ── Frontend host (Vercel) ───────────────────
# Deploy from repo root (vercel.json builds frontend/).
# In Vercel → Settings → Environment Variables, set ONLY:
#   VITE_API_URL=https://YOUR-API-HOST/api
# See frontend/.env.vercel.example
# Build: cd frontend && npm run build
# Set VITE_API_URL at build time (Vercel env or frontend/.env.production)

# ── API host (VPS / Railway / Render — not Vercel) ─
# Copy backend/.env.example → backend/.env
# Set FRONTEND_URL to your Vercel URL (https://….vercel.app)
# Run: npm run db:migrate && npm start

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
REDIS_ENABLED=false
BLOCKCHAIN_OPTIONAL=true

FABRIC_CHANNEL=icupaymentchannel
FABRIC_CHAINCODE=reconciliation-chaincode
FABRIC_IDENTITY=accountantAdmin

PYTHON_SERVICE_URL=http://127.0.0.1:8000
OCR_CONFIDENCE_THRESHOLD=0.65
UPLOAD_PATH=uploads
RUN_DB_MIGRATE=false
