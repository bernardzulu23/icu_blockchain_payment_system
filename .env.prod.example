# Production Environment Configuration Template
# Copy this to .env.prod and fill in real values
# NEVER commit this file to git

# ===========================================
# Application & Environment
# ===========================================
NODE_ENV=production
LOG_LEVEL=info

# Domain Configuration
FRONTEND_URL=https://payment.icu.edu.zm
VITE_API_URL=https://api.payment.icu.edu.zm

# ===========================================
# Database Configuration
# ===========================================
DB_NAME=icu_payments
DB_USER=postgres
# 🔒 CHANGE THIS: Use strong random password
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_32_CHARS_MIN

# ===========================================
# Redis Cache
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
# 🔒 CHANGE THIS: Use strong random password
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_MAX_MEMORY=512mb

# ===========================================
# JWT Authentication
# ===========================================
# 🔒 CHANGE THIS: Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET_BASE64_ENCODED
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_REFRESH_SECRET_BASE64_ENCODED
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ===========================================
# Docker Registry (for automated deployments)
# ===========================================
REGISTRY=docker.io
DOCKER_NAMESPACE=your_docker_hub_username
VERSION=latest

# ===========================================
# Services
# ===========================================
PYTHON_SERVICE_URL=http://python-service:8000
PYTHON_SERVICE_PORT=8000

# ===========================================
# Blockchain Configuration (optional)
# ===========================================
BLOCKCHAIN_OPTIONAL=true
FABRIC_CHANNEL=icupaymentchannel
FABRIC_CHAINCODE=reconciliation-chaincode
FABRIC_IDENTITY=accountantAdmin

# ===========================================
# File Uploads
# ===========================================
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=5242880  # 5MB in bytes
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

# ===========================================
# Email Configuration (SendGrid)
# ===========================================
# 🔒 Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=REPLACE_WITH_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=noreply@payment.icu.edu.zm
SENDGRID_FROM_NAME=ICU Payment System

# ===========================================
# Security Configuration
# ===========================================
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=https://payment.icu.edu.zm
CORS_CREDENTIALS=true

# ===========================================
# Monitoring & Logging
# ===========================================
# CloudWatch, DataDog, etc. (optional)
# MONITORING_ENABLED=false
# MONITORING_API_KEY=
# LOG_RETENTION_DAYS=30

# ===========================================
# Database Backup (optional)
# ===========================================
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
# BACKUP_RETENTION_DAYS=30

# ===========================================
# SSL/TLS Configuration
# ===========================================
# Handled by nginx in docker-compose.prod.yml
# Certificates should be in ./certs/ directory:
# - certs/cert.pem (certificate)
# - certs/privkey.pem (private key)
SSL_ENABLED=true
# HSTS max age in seconds (1 year)
HSTS_MAX_AGE=63072000

# ===========================================
# Database Replication (if using managed DB)
# ===========================================
# DATABASE_URL=postgresql://user:pass@db.example.com:5432/icu_payments
# DATABASE_DIRECT_URL=postgresql://user:pass@db.example.com:5432/icu_payments

# ===========================================
# Backup & Disaster Recovery
# ===========================================
# S3 or Cloud Storage for backups
# BACKUP_STORAGE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BACKUP_BUCKET=icu-backups

# ===========================================
# Feature Flags (optional)
# ===========================================
# FEATURE_BLOCKCHAIN_VERIFICATION=true
# FEATURE_AUTOMATED_MATCHING=true
# FEATURE_SMS_NOTIFICATIONS=false
# FEATURE_EMAIL_NOTIFICATIONS=true

# ===========================================
# Performance Tuning
# ===========================================
# Node.js
NODE_OPTIONS=--max-old-space-size=512

# Connection pooling
DB_POOL_MIN=5
DB_POOL_MAX=20

# Cache TTL (seconds)
CACHE_TTL_SHORT=300      # 5 minutes
CACHE_TTL_MEDIUM=3600    # 1 hour
CACHE_TTL_LONG=86400     # 24 hours

# ===========================================
# Development Overrides (NEVER in production)
# ===========================================
# DEBUG=false
# SKIP_VALIDATION=false
# MOCK_PAYMENT_GATEWAY=false

# ===========================================
# SECURITY CHECKLIST
# ===========================================
# Before deploying, verify:
# [ ] All 🔒 secrets changed from defaults
# [ ] Passwords are 32+ characters
# [ ] JWT secrets are base64-encoded random values
# [ ] No secrets committed to git
# [ ] SSL certificates valid
# [ ] Database backups configured
# [ ] Rate limiting enabled
# [ ] CORS properly configured
# [ ] Email service configured
# [ ] Monitoring & alerting enabled
# [ ] Database replicas configured
# [ ] File permissions correct (600 for .env.prod)
